# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Baby Action AI / GestureVerse-AI
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM / Generative AI (required for live explanation generation) ────────────
# Forge API key — used by server/_core/llm.ts to call the LLM.
# Without this key, the /api/explain route returns a rule-based fallback
# clearly labelled "LLM generation unavailable". ML inference is unaffected.
BUILT_IN_FORGE_API_KEY=your_forge_api_key_here

# Optional: override the default Forge API base URL.
# Default: https://forge.manus.im
# BUILT_IN_FORGE_API_URL=https://forge.manus.im

# ── Python inference service ──────────────────────────────────────────────────
# The Node backend proxies inference requests to this URL.
# Default: http://127.0.0.1:8000  (uvicorn running locally)
# INFERENCE_API_URL=http://127.0.0.1:8000

# ── Optional: override model paths ───────────────────────────────────────────
# MODEL_PATH=models/infant_pose_mlp.pt
# POSE_TASK_PATH=models/pose_landmarker_lite.task
# CONFIDENCE_THRESHOLD=0.56
# SMOOTHING_WINDOW=5

# ── Database (not required for inference/GenAI demo) ─────────────────────────
# DATABASE_URL=mysql://user:password@localhost:3306/babyaction

# ── Auth (not required for inference/GenAI demo) ─────────────────────────────
# JWT_SECRET=your_jwt_secret_here
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
